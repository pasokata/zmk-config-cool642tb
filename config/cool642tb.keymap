#include <behaviors.dtsi>
#include <behaviors/swapper.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>

#define DEF 0
#define MOU 1
#define SYM 2
#define NAV 3
#define NUM 4

/ {
    behaviors {
        rot_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEF {
            bindings = <
&kp Q       &kp W    &kp F             &kp P         &kp G                                                      &kp J          &kp L  &kp U      &kp Y       &kp SEMICOLON
&kp A       &kp R    &kp S             &kp T         &kp D         &none                 &none                  &kp H          &kp N  &kp E      &kp I       &kp O
&kp Z       &kp X    &kp C             &kp V         &kp B         &none                 &none                  &kp K          &kp M  &kp COMMA  &kp PERIOD  &kp SINGLE_QUOTE
&none       &none    &none             &kp LSHFT     &mo NAV       &kp TAB               &kp SPACE              &mo SYM                                      &none
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        MOU { 
            bindings = <
&trans       &trans    &trans            &trans          &trans                                                        &trans          &trans        &trans      &trans          &trans
&trans       &trans    &trans            &trans          &trans         &trans                  &trans                 &trans          &mo SYM       &trans      &trans          &trans
&trans       &trans    &trans            &trans          &trans         &trans                  &trans                 &trans          &mkp MB1      &mkp MB3    &mkp MB2        &mo MOU
&trans       &trans    &trans            &trans          &trans         &trans                  &trans                 &trans                                                    &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        SYM {
            bindings = <
&kp TAB          &kp LBKT       &kp LBRC     &kp LPRN     &kp TILD                                           &kp CARET       &kp RPRN      &kp RBRC              &kp RBKT               &kp GRAVE
&kp MINUS        &kp ASTERISK   &kp EQUAL    &kp UNDER    &kp DLLR      &none             &none              &kp HASH        &sk RCTRL     &sk RSHFT             &sk RALT               &sk RGUI
&kp PLUS         &kp PIPE       &kp AT       &kp SLASH    &kp PERCENT   &none             &none              &none           &kp BACKSLASH &kp AMPERSAND         &kp EXCLAMATION        &kp QUESTION 
&none            &none          &none        &trans       &trans        &trans            &trans             &trans                                                                     &trans
            >;

            sensor-bindings = <&rot_msc SCRL_RIGHT SCRL_LEFT>;
        };

        NAV {
            bindings = <
&kp ESCAPE       &sw LALT TAB      &sw LCTRL LS(TAB) &sw LCTRL TAB   &kp C_VOLUME_UP                                      &kp CAPSLOCK       &kp HOME         &kp UP        &kp END            &kp DELETE
&sk LGUI         &sk LALT          &sk LSHFT         &sk LCTRL       &kp C_VOLUME_DOWN    &none       &none               &none              &kp LEFT         &kp DOWN      &kp RIGHT          &kp BACKSPACE
&kp LA(LG(LEFT)) &kp LA(LG(RIGHT)) &mkp MB4          &mkp MB5        &kp C_MUTE           &none       &none               &kp LA(LC(T))      &kp PAGE_DOWN    &kp PAGE_UP   &sw LCTRL SPC      &kp ENTER 
&none            &none             &none             &trans          &trans               &trans      &trans              &trans                                                               &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        NUM {
            bindings = <
&kp N1           &kp N2            &kp N3            &kp N4          &kp N5                                               &kp N6        &kp N7        &kp N8        &kp N9        &kp N0
&sk LGUI         &sk LALT          &sk LSHFT         &sk LCTRL       &kp F11              &none       &none               &kp F12       &sk RCTRL     &sk RSHFT     &sk RALT      &sk RGUI
&kp F1           &kp F2            &kp F3            &kp F4          &kp F5               &none       &none               &kp F6        &kp F7        &kp F8        &kp F9        &kp F10
&none            &none             &none             &trans          &trans               &trans      &trans              &trans                                                  &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };
};
